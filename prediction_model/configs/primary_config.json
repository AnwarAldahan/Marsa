{
  "random_seed": 42,
  "horizons_hours": [1, 3, 6, 12],
  "sequence_context_lengths_hours": [24, 48, 72],
  "tabular_lag_hours": [1, 3, 6, 12, 24],
  "tabular_rolling_windows_hours": [3, 6, 12, 24],
  "target_definition": {
    "negative_operations_status": ["NORMAL", "MODERATE"],
    "positive_operations_status": ["ELEVATED", "CRITICAL"],
    "primary_input_policy": "exclude operations_status"
  },
  "split_policy": {
    "basis": "future target timestamp",
    "train": "2025-01-01 through 2025-09-30 UTC",
    "validation": "2025-10-01 through 2025-11-30 UTC",
    "test": "2025-12-01 through 2025-12-31 UTC"
  },
  "threshold_policy": "validation-only threshold search, prefer F1 among thresholds with recall >= 0.70",
  "calibration_policy": "validation-only Platt sigmoid when validation Brier Score and Log Loss do not worsen"
}
